{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckArchiveProtection",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:GetBucketPublicAccessBlock"],
      "Resource": "arn:aws:s3:::SUBSTITUA_PELO_BUCKET"
    },
    {
      "Sid": "WriteAndReadPatientDocuments",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::SUBSTITUA_PELO_BUCKET/prontuarios/*"
    }
  ]
}
